# Backend-only settings. Copy to backend/.env for live mode.
VYUMI_MERCHANT_TOKEN=replace-with-a-long-local-token
VYUMI_FASHN_API_KEY=
VYUMI_GEMINI_API_KEY=
VYUMI_GEMINI_MODEL=gemini-3.1-flash-image
# Both Cloudflare values select Workers AI instead of Gemini/FASHN.
VYUMI_CLOUDFLARE_ACCOUNT_ID=
VYUMI_CLOUDFLARE_API_TOKEN=
VYUMI_CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
# Total request allowance for this database, not an exact monetary spend cap.
VYUMI_GENERATION_ALLOWANCE=0
VYUMI_GENERATION_MODE=live
